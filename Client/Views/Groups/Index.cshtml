@model List<ContactGroupModel>
@{
    ViewData["Title"] = "Группы";
    var search = ViewData["Search"] as string;
}

<h1>@ViewData["Title"]</h1>

<partial name="_StatusMessage" />

<p class="text-muted">Через API получено групп: <strong>@Model.Count</strong></p>

<form asp-action="Index" method="get" class="card card-body mb-3">
    <div class="row g-2 align-items-end">
        <div class="col-md-6">
            <label class="form-label" for="search">Поиск по названию или описанию</label>
            <input type="text" id="search" name="search" value="@search" class="form-control" placeholder="Например: отдел" />
        </div>
        <div class="col-md-6 d-flex gap-2">
            <button type="submit" class="btn btn-primary">Фильтр</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Сброс</a>
            <a asp-action="Create" class="btn btn-success">Добавить</a>
        </div>
    </div>
</form>

@if (Model.Count == 0)
{
    <div class="alert alert-info">По заданным условиям группы не найдены.</div>
}
else
{
    <table class="table table-striped table-hover align-middle">
        <thead class="table-light">
            <tr>
                <th>Id</th>
                <th>Название</th>
                <th>Описание</th>
                <th>Контактов</th>
                <th style="width: 220px;">Действия</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var group in Model)
            {
                <tr>
                    <td>@group.Id</td>
                    <td>@group.Name</td>
                    <td>@group.Description</td>
                    <td>
                        <a asp-controller="Contacts" asp-action="Index" asp-route-groupId="@group.Id">@group.ContactsCount</a>
                    </td>
                    <td>
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@group.Id">Просмотр</a>
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@group.Id">Изменить</a>
                        <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@group.Id">Удалить</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
